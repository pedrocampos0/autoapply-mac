# Required for Gmail report integration
GMAIL_ACCOUNT=your.email@example.com

# Optional Ollama configuration
OLLAMA_MODEL=llama2:7b-chat-q2_K
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_NUM_GPU=24

# Optional exact LinkedIn profile URL
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-profile/

# Optional path overrides
# AUTOAPPLY_PROFILE_FILE=/Users/your-name/path/to/candidate_profile.json
# AUTOAPPLY_CHROME_PROFILE=/Users/your-name/Library/Application Support/AutoApply/ChromeProfile
# AUTOAPPLY_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
